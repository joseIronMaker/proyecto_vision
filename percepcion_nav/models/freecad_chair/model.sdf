<?xml version="1.0"?>
<!--
  Silla objetivo, versión 2 (data-model.md, "Silla objetivo"; freecad/make_chair.py).
  Dos mallas de FreeCAD en mm, escaladas a metros: estructura de madera y cojines de tela, cada
  una con su material. La colisión usa cajas con las mismas dimensiones de la macro. Origen en
  el centro de la huella; frente hacia +X.
-->
<sdf version="1.9">
  <model name="freecad_chair">
    <static>true</static>
    <link name="chair_link">
      <visual name="frame">
        <geometry>
          <mesh>
            <uri>model://freecad_chair/meshes/chair_frame.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.28 0.17 0.09 1</ambient>
          <diffuse>0.28 0.17 0.09 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
        </material>
      </visual>
      <visual name="cushions">
        <geometry>
          <mesh>
            <uri>model://freecad_chair/meshes/chair_cushions.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.05 0.25 0.45 1</ambient>
          <diffuse>0.05 0.25 0.45 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>

      <!-- Patas: 0.04 x 0.04 x 0.62 en las esquinas -->
      <collision name="leg_front_left">
        <pose>0.24 0.26 0.31 0 0 0</pose>
        <geometry><box><size>0.04 0.04 0.62</size></box></geometry>
      </collision>
      <collision name="leg_front_right">
        <pose>0.24 -0.26 0.31 0 0 0</pose>
        <geometry><box><size>0.04 0.04 0.62</size></box></geometry>
      </collision>
      <collision name="leg_rear_left">
        <pose>-0.24 0.26 0.31 0 0 0</pose>
        <geometry><box><size>0.04 0.04 0.62</size></box></geometry>
      </collision>
      <collision name="leg_rear_right">
        <pose>-0.24 -0.26 0.31 0 0 0</pose>
        <geometry><box><size>0.04 0.04 0.62</size></box></geometry>
      </collision>
      <!-- Brazos -->
      <collision name="arm_left">
        <pose>0.01 0.255 0.635 0 0 0</pose>
        <geometry><box><size>0.54 0.05 0.03</size></box></geometry>
      </collision>
      <collision name="arm_right">
        <pose>0.01 -0.255 0.635 0 0 0</pose>
        <geometry><box><size>0.54 0.05 0.03</size></box></geometry>
      </collision>
      <!-- Travesaños laterales y frontal (el frontal hace de faldón para la profundidad) -->
      <collision name="side_rail_left">
        <pose>0 0.26 0.32 0 0 0</pose>
        <geometry><box><size>0.44 0.04 0.04</size></box></geometry>
      </collision>
      <collision name="side_rail_right">
        <pose>0 -0.26 0.32 0 0 0</pose>
        <geometry><box><size>0.44 0.04 0.04</size></box></geometry>
      </collision>
      <collision name="front_rail">
        <pose>0.24 0 0.305 0 0 0</pose>
        <geometry><box><size>0.04 0.48 0.05</size></box></geometry>
      </collision>
      <!-- Cojines -->
      <collision name="seat_cushion">
        <pose>0.01 0 0.385 0 0 0</pose>
        <geometry><box><size>0.48 0.48 0.11</size></box></geometry>
      </collision>
      <collision name="backrest_cushion">
        <pose>-0.2407 0 0.6752 0 -0.1745 0</pose>
        <geometry><box><size>0.10 0.48 0.46</size></box></geometry>
      </collision>
    </link>
  </model>
</sdf>
